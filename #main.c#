}



int16_t getFileSize(char *fname)
{
  FILE *fptr = fopen(fname, "r");
  if (fptr == NULL)
    return -1;

  int16_t fsize = 0;

  fseek(fptr, 0, SEEK_END);
  fsize = ftell(fptr);
  fseek(fptr, 0, SEEK_SET);

  fclose(fptr);
  return fsize;
}



